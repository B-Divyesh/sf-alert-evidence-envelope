{
  "name": "alert-evidence-envelope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "test": "npm run check && cargo test --locked && npm run test:deployment-policy && npm run test:claims-manifest && npm run test:browser:prepare && playwright test",
    "test:claims": "npm run test:browser:prepare && playwright test",
    "test:browser:prepare": "VITE_BUILD_SHA=test-build-identity npm run build && BUILD_SHA=test-build-identity cargo build --locked",
    "test:deployment-policy": "node scripts/test-deployment-policy.mjs",
    "test:claims-manifest": "node scripts/test-claims-manifest.mjs",
    "verify:live-topology": "bash scripts/verify-live-topology.sh",
    "deploy": "bash scripts/deploy-durable-container.sh",
    "test:e2e": "playwright test",
    "check": "svelte-check --tsconfig ./frontend/tsconfig.json",
    "preview": "vite preview --config frontend/vite.config.ts --host 0.0.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.3.0",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
