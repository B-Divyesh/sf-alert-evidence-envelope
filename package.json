  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "24.3.0",
    "svelte": "5.56.10",
    "svelte-check": "4.3.1",
    "typescript": "5.9.2",
    "vite": "8.2.2"
  }
}
